{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UKHSA-Internal/devops-pipeline/packages/settings-checker/settings.schema.json",
  "title": "UKHSA pipeline settings",
  "description": "Field types and structure of .github/pipeline-settings.yml. Each property names the rule (x-rule) that reports its violations; rule severities and cross-field rules live in checker.py.",
  "type": "object",
  "x-message": "must be a mapping",
  "required": ["version", "service", "environments", "governance", "verification", "deploy"],
  "properties": {
    "version": {
      "x-rule": "CHK-01",
      "type": "string",
      "x-message": "must be a string"
    },
    "service": {
      "x-rule": ["CHK-02", "CHK-11"],
      "type": "object",
      "x-message": "must be a mapping",
      "required": ["name", "owner_team", "language", "test_command"],
      "properties": {
        "name": { "$ref": "#/$defs/serviceField" },
        "owner_team": { "$ref": "#/$defs/serviceField" },
        "language": { "$ref": "#/$defs/serviceField" },
        "test_command": {
          "x-rule": "CHK-11",
          "type": "string",
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
          "x-message": "must be a non-empty, single-line string"
        }
      }
    },
    "environments": {
      "x-rule": "CHK-03",
      "type": "array",
      "x-message": "must be a list",
      "items": {
        "type": "object",
        "x-message": "must be a mapping",
        "required": ["name", "category", "account_id", "role_name", "region"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "x-message": "must start with a letter or number and contain only letters, numbers, '.', '_' and '-'"
          },
          "category": {
            "enum": ["Development", "Pre-production", "Production"],
            "x-message": "must be one of Development, Pre-production, Production"
          },
          "account_id": {
            "type": ["string", "integer"],
            "pattern": "\\S",
            "x-message": "must be a non-empty string"
          },
          "role_name": { "$ref": "#/$defs/nonEmptyString" },
          "region": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "governance": {
      "x-rule": ["CHK-05", "CHK-06"],
      "type": "object",
      "x-message": "must be a mapping",
      "required": ["retention_days", "approvers"],
      "properties": {
        "retention_days": {
          "x-rule": "CHK-06",
          "type": "integer",
          "minimum": 1,
          "x-message": "must be an integer greater than zero"
        },
        "approvers": {
          "x-rule": "CHK-05",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "x-message": "must be a non-empty list of approver group names"
        }
      }
    },
    "verification": {
      "x-rule": "CHK-07",
      "type": "object",
      "x-message": "must be a mapping",
      "required": ["db_check_required"],
      "properties": {
        "health_endpoint": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$",
          "x-message": "must be a URL path starting with '/'"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "x-message": "must be an integer greater than zero"
        },
        "db_check_required": {
          "type": "boolean",
          "x-message": "must be true or false"
        },
        "custom_checks": {
          "x-rule": "CHK-08",
          "type": "array",
          "x-message": "must be a list",
          "items": {
            "type": "object",
            "x-message": "must be a mapping",
            "required": ["name", "command", "allow_failure"],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmptyString" },
              "command": { "$ref": "#/$defs/nonEmptyString" },
              "timeout_seconds": {
                "type": "integer",
                "x-message": "must be an integer"
              },
              "allow_failure": {
                "type": "boolean",
                "x-message": "must be true or false"
              }
            }
          }
        }
      }
    },
    "deploy": {
      "x-rule": "CHK-09",
      "type": "object",
      "x-message": "must be a mapping",
      "required": ["production"],
      "properties": {
        "production": {
          "type": "object",
          "x-message": "must be a mapping",
          "required": ["approval_mode"],
          "properties": {
            "approval_mode": {
              "enum": ["all-approvers", "single-approver", "unattended"],
              "x-message": "must be one of all-approvers, single-approver, unattended"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S",
      "x-message": "must be a non-empty string"
    },
    "serviceField": {
      "x-rule": "CHK-02",
      "type": "string",
      "pattern": "\\S",
      "x-message": "must be a non-empty string"
    }
  }
}
